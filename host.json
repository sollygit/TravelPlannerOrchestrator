{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "logging": {
    "logLevel": {
      "Function": "Information"
    }
  },
  "extensions": {
    "durableTask": {
      "storageProvider": {
        "type": "azureManaged",
        "connectionStringName": "DURABLE_TASK_SCHEDULER_CONNECTION_STRING"
      },
      "hubName": "%TASKHUB_NAME%",
      "tracing": {
        "distributedTracingEnabled": true,
        "version": "V2"
      }
    }
  }
}